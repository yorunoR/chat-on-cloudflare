{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate api_dev --local",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop"
  },
  "dependencies": {
    "@sson0-er/drizzle-admin": "0.1.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.110.0"
  }
}
