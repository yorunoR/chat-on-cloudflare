  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "api_dev",
      "database_id": ""
    }
  ],
  "env": {
    "ai": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "api_ai",
          "database_id": ""
        }
      ]
    }
  }
